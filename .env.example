# ── LLM provider (any OpenAI-compatible chat-completions API) ────────────────
# Default: Nebius Token Factory. Switch providers by changing ONLY these variables.
# Check the model IDs your key can use with: npm run models
#
# Nebius Token Factory (default) — https://docs.tokenfactory.nebius.com
LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1
LLM_API_KEY=
# Model IDs as published in Nebius' token-factory-cookbook (models/nemotron, Oct 2026).
# IDs are case-sensitive and Nebius has announced model rotations.
# (Lightning is the Nano-class model Nebius currently features; run `npm run probe` to confirm your key can call each one.)
MODEL_NANO=nvidia/Nemotron-3_5-Lightning
MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b
#
# NVIDIA API (build.nvidia.com) — same Nemotron family, for development.
# Uncomment these and comment out the Nebius block above. NOTE: /v1/models LISTS more models than a free key can
# CALL (e.g. nemotron-nano-3-30b-a3b and nemotron-3-super-120b-a12b returned 404 "Function not found for account"
# in our tests), so run `npm run probe` and use IDs that say OK. These were callable (Oct 2026):
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_API_KEY=nvapi-...
# MODEL_NANO=nvidia/nemotron-3.5-lightning-30b-a3b
# MODEL_SUPER=nvidia/nemotron-3.5-super-vl-120b-a12b
# MODEL_ULTRA=nvidia/nemotron-3-ultra-550b-a55b
# MODEL_VISION=nvidia/nemotron-3.5-super-vl-120b-a12b
# The free NVIDIA API is rate limited (~40 req/min); Rootline throttles to LLM_RPM=30 automatically.
#
# Optional: label for logs/routing panel (nebius | nvidia | openai-compatible); inferred from LLM_BASE_URL.
LLM_PROVIDER=
# Older names NEBIUS_API_KEY / NEBIUS_BASE_URL / NEBIUS_VISION_BASE_URL still work as fallbacks.

# An NVIDIA vision-language model on your provider (e.g. Nemotron 3.5 Super VL / Nemotron 3 Nano Omni).
# Leave empty to use the Tesseract.js OCR + Nano cleanup path. On Token Factory the vision model ID is not in the public
# cookbook: run `npm run verify-nebius`, which lists vision-capable candidates on your key.
MODEL_VISION=
# Optional: some multimodal models are served from a different (e.g. regional) base URL.
LLM_VISION_BASE_URL=
# Voice notes and video are a FEATURE FLAG: OFF unless ASR_ENDPOINT_URL is set (and UNTESTED against a real endpoint).
# Point it at any OpenAI-compatible /v1/audio/transcriptions server (e.g. a Whisper server, or NVIDIA Parakeet/Canary
# behind a gateway). MODEL_ASR is the model name on that endpoint. Leave all three empty to keep the options hidden.
MODEL_ASR=
ASR_ENDPOINT_URL=
ASR_API_KEY=
# Nemotron 3 reasons by default; Rootline turns thinking off for structured stages.
LLM_DISABLE_THINKING=true
# Max LLM requests per minute across all stages (0 = unlimited). Defaults to 30 on the NVIDIA API, unlimited elsewhere.
LLM_RPM=
# Dev only: cache Tavily + LLM responses on disk in .cache/ (saves credits while iterating). Ignored on Vercel.
DEV_CACHE=false
# Send response_format={"type":"json_object"} (output is Zod-validated either way). Auto-dropped per model on HTTP 400.
LLM_JSON_MODE=true

# ── Tavily ───────────────────────────────────────────────────────────────────
TAVILY_API_KEY=

# ── Supabase (optional; falls back to local JSON in .data/) ─────────────────
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Modes ───────────────────────────────────────────────────────────────────
# Replay saved runs for pasted demo messages (example chips always replay).
DEMO_MODE=false
# Run the whole pipeline offline against a FICTIONAL corpus with deterministic heuristics.
OFFLINE_MOCK=false

# ── Budgets (optional) ──────────────────────────────────────────────────────
MAX_QUERIES=8
MAX_CANDIDATE_PAGES=40
MAX_PAIRS=80
MODEL_CONCURRENCY=6
# USD per 1M tokens, for the routing panel (defaults: Token Factory list prices, Oct 2026;
# on other providers the panel labels these as an estimate)
PRICE_NANO_IN=0.06
PRICE_NANO_OUT=0.24
PRICE_SUPER_IN=0.30
PRICE_SUPER_OUT=0.90
PRICE_ULTRA_IN=1.00
PRICE_ULTRA_OUT=3.00
