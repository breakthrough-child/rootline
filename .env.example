# ── Nebius Token Factory (OpenAI-compatible) ─────────────────────────────────
# Docs: https://docs.tokenfactory.nebius.com  ·  list models for your key: npm run models
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Model IDs as published in Nebius' token-factory-cookbook (models/nemotron, Oct 2026).
# Verify with `npm run models` — IDs are case-sensitive and Nebius has announced model rotations.
MODEL_NANO=nvidia/nvidia-nemotron-3-nano-30b-a3b
MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b
# An NVIDIA vision-language model on Token Factory (e.g. Nemotron 3.5 Super VL / Nemotron 3 Nano Omni).
# Leave empty to use the Tesseract.js OCR + Nano cleanup path.
MODEL_VISION=
# Optional: some multimodal models are served from a regional base URL.
NEBIUS_VISION_BASE_URL=
# Speech-to-text. If ASR_ENDPOINT_URL is set, MODEL_ASR names the model on that endpoint
# (an OpenAI-compatible /v1/audio/transcriptions server, e.g. NVIDIA Parakeet/Canary NIM or a
# Whisper server on a Nebius Serverless Endpoint). Otherwise MODEL_ASR is a Token Factory model
# that accepts input_audio. Leave both empty to type transcripts manually.
MODEL_ASR=
ASR_ENDPOINT_URL=
ASR_API_KEY=
# Nemotron 3 reasons by default; Rootline turns thinking off for structured stages.
NEBIUS_DISABLE_THINKING=true

# ── Tavily ───────────────────────────────────────────────────────────────────
TAVILY_API_KEY=

# ── Supabase (optional; falls back to local JSON in .data/) ─────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Modes ───────────────────────────────────────────────────────────────────
# Replay saved runs for pasted demo messages (example chips always replay).
DEMO_MODE=false
# Run the whole pipeline offline against a FICTIONAL corpus with deterministic heuristics.
OFFLINE_MOCK=false

# ── Budgets (optional) ──────────────────────────────────────────────────────
MAX_QUERIES=8
MAX_CANDIDATE_PAGES=40
MAX_PAIRS=80
MODEL_CONCURRENCY=6
# USD per 1M tokens, for the routing panel (defaults: Token Factory list prices, Oct 2026)
PRICE_NANO_IN=0.06
PRICE_NANO_OUT=0.24
PRICE_SUPER_IN=0.30
PRICE_SUPER_OUT=0.90
PRICE_ULTRA_IN=1.00
PRICE_ULTRA_OUT=3.00
